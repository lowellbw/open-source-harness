# Copy to .env.local (git-ignored) and fill in.
#
# Never commit real values. `.gitignore` covers `.env` and `.env.*`, with this
# example file as the single exception.

# The only credential required. Every model routes through OpenRouter.
OPENROUTER_API_KEY=sk-or-...

# Optional. Without it, web search still works — the gateway attaches
# OpenRouter's own server-side search to the request instead, which needs no
# second credential and adds no sub-processor to disclose (PLAN-V2 §6.4).
#
# With it, search becomes an explicit tool call: visible query, inspectable
# results, its own line in the trace. Brave is also what Claude uses, runs its
# own index, and measures fastest in the 2026 agent benchmarks (~670ms).
#
# Note it bills. Brave removed its free tier in February 2026: every plan now
# holds a card, gives $5/month of credit (~1,000 searches), and charges $5 per
# 1,000 beyond that.
BRAVE_API_KEY=

# Two-letter country code, or ALL. Affects ranking noticeably.
BRAVE_SEARCH_COUNTRY=ALL

# Where conversations, workspaces and the SQLite database live.
# Defaults to ~/.agentic-workspace.
# AGENTIC_WORKSPACE_HOME=
