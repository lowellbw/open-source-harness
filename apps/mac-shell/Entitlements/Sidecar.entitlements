<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Entitlements for the bundled Node runtime, signed separately from the app.

    Under the hardened runtime (which notarization requires) V8 cannot allocate
    executable memory without allow-jit, and native addons compiled by npm are signed
    by whoever built them — not by us — so library validation has to be relaxed for
    the sidecar process only. The app's own signature keeps all three off.

    Re-check whether allow-unsigned-executable-memory is still needed for the Node
    version being shipped: recent V8 works with allow-jit alone on arm64, and dropping
    it is a real reduction in attack surface.
  -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
